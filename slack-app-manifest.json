{
  "display_information": {
    "name": "Lilith",
    "description": "Drive your herdr agent panes from Slack.",
    "background_color": "#1a1d21"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Lilith",
      "always_online": true
    },
    "assistant_view": {
      "assistant_description": "Talk to your herdr agents. One thread per pane.",
      "suggested_prompts": []
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "assistant:write",
        "chat:write",
        "im:history",
        "files:read",
        "files:write",
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "users:read",
        "reactions:write",
        "channels:read",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "assistant_thread_started",
        "assistant_thread_context_changed",
        "message.im",
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
